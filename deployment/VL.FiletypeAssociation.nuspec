<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
  <metadata>
    <id>VL.FileTypeAssociation</id>
    <version>0.2.0</version>
    <title>VL.FileTypeAssociation</title>
    <authors>sebl</authors>
    <projectUrl>https://github.com/sebllll/VL.FileTypeAssociation</projectUrl>
    <repository type="git" url="https://github.com/sebllll/VL.FileTypeAssociation.git" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>vvvv nodes to query, set and force Windows file type associations (per-user), including the hash-protected UserChoice default on Windows 10/11.</description>
    <tags>VL, VVVV, System, Application, FileType, Association, Windows</tags>
    <license type="expression">LGPL-3.0-only</license>
    <icon>icon\nugeticon.png</icon>
    <readme>docs\README.md</readme>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Win32.Registry" version="4.7.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\lib\**\FiletypeAssoc.dll" target="lib\" />
    <file src="..\lib\**\FiletypeAssoc.pdb" target="lib\" />
    <file src="..\lib\**\FiletypeAssoc.xml" target="lib\" />
    <file src="..\lib\**\FiletypeAssoc.deps.json" target="lib\" />
    <file src="..\*.vl" target="" />
    <file src="..\help\**" target="help\" />
    <file src="nugeticon.png" target="icon\" />
    <file src="..\README.md" target="docs\" />
  </files>
</package>
